#include <stdio.h>

int main()
{
    char a, b, c, d;
    
    printf("Enter expression (a=b+c*d): ");
    scanf("%c=%c+%c*%c", &a, &b, &c, &d);

    printf("\nTriple Representation:\n");

    printf("Instruction\tOperator\tArg1\tArg2\n");
    printf("0\t\t*\t\t%c\t%c\n", c, d);
    printf("1\t\t+\t\t%c\t(0)\n", b);
    printf("2\t\t=\t\t(1)\t%c\n", a);

    return 0;
}
